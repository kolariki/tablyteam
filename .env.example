# ─── LLM providers (completá las que tengas; las que falten se pueden simular con "mock") ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1   # solo para keys de China continental
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Modelos por defecto (opcional; en la UI también se eligen de la lista real del proveedor)
# DEFAULT_MODEL_ANTHROPIC=claude-sonnet-5-5
# DEFAULT_MODEL_OPENAI=gpt-5-mini
# DEFAULT_MODEL_DEEPSEEK=deepseek-chat        # o deepseek-reasoner para ver su razonamiento nativo
# DEFAULT_MODEL_GEMINI=gemini-2.5-flash
# OPENAI_REASONING_EFFORT=low
# Precio propio por modelo (USD por 1M tokens in,out):  ARENA_PRICE_GPT_5_MINI=0.25,2

# ─── Langfuse (SDK v4) ─── cloud: https://cloud.langfuse.com  |  local: docker compose (ver README)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=dev

# Bootstrap del Langfuse local (crea org, proyecto, usuario y las keys de arriba al primer arranque)
LANGFUSE_INIT_ORG_ID=agent-arena
LANGFUSE_INIT_ORG_NAME="Agent Arena"
LANGFUSE_INIT_PROJECT_ID=agent-arena
LANGFUSE_INIT_PROJECT_NAME="Agent Arena"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@arena.local
LANGFUSE_INIT_USER_NAME="Arena Admin"
LANGFUSE_INIT_USER_PASSWORD=

# Cuentas
# ARENA_ALLOW_SIGNUP=true       # false = solo login (cuentas ya creadas)
# ARENA_TOKEN_TTL_DAYS=30

# Keys por usuario (Configuración): se cifran con este secreto. Si no se define, se genera en backend/data/.secret
# ARENA_SECRET_KEY=
# ARENA_SHARE_SERVER_KEYS=false  # true = los usuarios sin key propia usan las keys de este .env

# Pedir un developer (opcional): links de pago por paquete (Stripe Payment Links) y agenda (Cal.com)
FDE_CHECKOUT_URL_LAUNCH=
FDE_CHECKOUT_URL_INTEGRATION=
FDE_CHECKOUT_URL_REVIEW=
FDE_CHECKOUT_URL_HOURS=
FDE_BOOKING_URL=
